# Azure PostgreSQL RAG API Configuration
# Copy this file to .env.azure and fill in your actual values

# ============================================================================
# Azure PostgreSQL Configuration
# ============================================================================

# Option 1: Use full connection string (DSN)
AZURE_POSTGRESQL_DSN=postgresql://username@servername:password@servername.postgres.database.azure.com:5432/dbname?sslmode=require

# Option 2: Use individual connection parameters
AZURE_DB_HOST=your-server.postgres.database.azure.com
AZURE_DB_PORT=5432
AZURE_DB_NAME=rag_db
AZURE_DB_USER=your_username@your-server
AZURE_DB_PASSWORD=your_secure_password

# ============================================================================
# Vector Store Configuration
# ============================================================================

# Force Azure PGVector (already set in Dockerfile, but can override)
FORCE_AZURE_PGVECTOR=true

# Disable automatic extension creation (Azure PostgreSQL requires pre-existing extensions)
PGVECTOR_CREATE_EXTENSION=false

# ============================================================================
# Embedding Provider Configuration
# ============================================================================

# OpenAI (Standard)
OPENAI_API_KEY=sk-...

# OR Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OR Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434

# OR Hugging Face
HUGGINGFACE_API_KEY=hf_...

# ============================================================================
# Application Settings
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Testing mode
TESTING=false

# API Configuration
API_TITLE=RAG API (Azure)
API_VERSION=1.0.0

# ============================================================================
# Security (Optional)
# ============================================================================

# JWT Secret for authentication (if enabled)
JWT_SECRET=your-secret-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# Azure-Specific Settings
# ============================================================================

# Azure Application Insights (if using)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Azure Key Vault (if using for secrets)
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# ============================================================================
# Notes
# ============================================================================

# 1. Ensure pgvector extension is enabled in your Azure PostgreSQL Flexible Server:
#    - Go to Azure Portal > Your PostgreSQL Server > Server parameters
#    - Find "azure.extensions" and add "vector" to the list
#    - Restart if required
#    - Run: CREATE EXTENSION IF NOT EXISTS vector;

# 2. For Azure PostgreSQL, use SSL connection:
#    - Add "?sslmode=require" to your connection string
#    - Download SSL certificate if needed from Azure Portal

# 3. Firewall rules:
#    - Ensure your deployment IP/Container is whitelisted in Azure PostgreSQL firewall
#    - Or enable "Allow Azure services" option

# 4. Authentication:
#    - Username format: username@servername
#    - Or use Azure AD authentication (requires additional configuration)
